#!/usr/bin/env sh
# Consistency half of the ACID property from lecture 03: a commit may not leave
# the tree in a state that fails its own verification.
#
# Enabled by `make setup`. Bypass with --no-verify only when you intend to commit
# a known-broken tree and have said so in PROGRESS.md.
set -e
echo "pre-commit: make check"
make check >/dev/null
echo "pre-commit: harness check"
pnpm exec tsx scripts/harness.ts check >/dev/null
