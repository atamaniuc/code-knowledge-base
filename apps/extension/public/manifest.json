{
  "manifest_version": 3,
  "name": "Interview Prep",
  "version": "0.1.0",
  "description": "Spaced-repetition interview practice that runs locally. Nothing leaves the device unless you select a phrase and ask it to be translated.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://clients5.google.com/*",
    "https://translate.googleapis.com/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Interview Prep",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
